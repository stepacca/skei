rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check endpoint
    match /test/connection {
      allow read: if true;
    }

    // Common Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid'])
        && data.uid is string
        && data.uid == request.auth.uid
        && (!('email' in data) || (data.email is string && data.email.size() <= 255))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('lastSyncedAt' in data) || (data.lastSyncedAt is string && data.lastSyncedAt.size() <= 100))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100))
        && (!('seedV2Applied' in data) || data.seedV2Applied is bool);
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'initialBalance'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.type in ['checking', 'savings', 'credit', 'cash', 'investment']
        && (data.initialBalance is number || data.initialBalance is int)
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('institution' in data) || (data.institution is string && data.institution.size() <= 100))
        && (!('color' in data) || (data.color is string && data.color.size() <= 50))
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 50))
        && (!('isArchived' in data) || data.isArchived is bool)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidCategoryGroup(data) {
      return data.keys().hasAll(['id', 'name'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('targetAllocationPercent' in data) || data.targetAllocationPercent is number || data.targetAllocationPercent is int)
        && (!('kind' in data) || data.kind in ['expense', 'income'])
        && (!('description' in data) || (data.description is string && data.description.size() <= 255))
        && (!('categories' in data) || data.categories is list)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidGroupOccasion(data) {
      return data.keys().hasAll(['id', 'name', 'emoji'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.emoji is string && data.emoji.size() <= 10
        && (!('description' in data) || (data.description is string && data.description.size() <= 255))
        && (!('budget' in data) || data.budget is number || data.budget is int)
        && (!('isPinnedAlwaysActive' in data) || data.isPinnedAlwaysActive is bool)
        && (!('isArchived' in data) || data.isArchived is bool)
        && (!('order' in data) || data.order is number || data.order is int)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidPerson(data) {
      return data.keys().hasAll(['id', 'name', 'emoji'])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.emoji is string && data.emoji.size() <= 10
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'type', 'amount', 'accountId', 'date'])
        && data.id is string && isValidId(data.id)
        && data.type in ['expense', 'income', 'transfer']
        && (data.amount is number || data.amount is int)
        && data.accountId is string && isValidId(data.accountId)
        && data.date is string && data.date.size() <= 100
        && (!('toAccountId' in data) || (data.toAccountId is string && isValidId(data.toAccountId)))
        && (!('categoryId' in data) || (data.categoryId is string && isValidId(data.categoryId)))
        && (!('subcategoryId' in data) || (data.subcategoryId is string && isValidId(data.subcategoryId)))
        && (!('groupId' in data) || (data.groupId is string && isValidId(data.groupId)))
        && (!('occasionGroupId' in data) || (data.occasionGroupId is string && isValidId(data.occasionGroupId)))
        && (!('owedByPersonId' in data) || (data.owedByPersonId is string && isValidId(data.owedByPersonId)))
        && (!('owedAmount' in data) || data.owedAmount is number || data.owedAmount is int)
        && (!('isSettled' in data) || data.isSettled is bool)
        && (!('settledAt' in data) || (data.settledAt is string && data.settledAt.size() <= 100))
        && (!('settledRepaymentId' in data) || (data.settledRepaymentId is string && isValidId(data.settledRepaymentId)))
        && (!('varianceTag' in data) || (data.varianceTag is string && data.varianceTag.size() <= 50))
        && (!('tags' in data) || data.tags is list)
        && (!('note' in data) || (data.note is string && data.note.size() <= 255))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // User Private Store
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId);

      // Bank Accounts
      match /accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(accountId) && isValidAccount(incoming());
        allow delete: if isOwner(userId) && isValidId(accountId);
      }

      // Categories
      match /categoryGroups/{groupId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(groupId) && isValidCategoryGroup(incoming());
        allow delete: if isOwner(userId) && isValidId(groupId);
      }

      // Groups & Occasions
      match /groups/{groupId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(groupId) && isValidGroupOccasion(incoming());
        allow delete: if isOwner(userId) && isValidId(groupId);
      }

      // People & Debts
      match /people/{personId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(personId) && isValidPerson(incoming());
        allow delete: if isOwner(userId) && isValidId(personId);
      }

      // Transactions / Movements
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming());
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }
    }
  }
}
